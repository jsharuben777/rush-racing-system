@{
    Layout = null;
    var machines = ViewBag.Machines as List<RushRacing.Core.Entities.Machine>;
    var heartbeats = ViewBag.Heartbeats as Dictionary<int, RushRacing.Core.Entities.MachineHeartbeat?>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rush Racing — Machines</title>
    <meta http-equiv="refresh" content="10" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #0a0a1a;
            color: white;
            padding: 20px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .logo {
            font-size: 24px;
            font-weight: 900;
            color: #ff3333;
        }

        .nav a {
            color: #888;
            text-decoration: none;
            margin-left: 20px;
            font-size: 14px;
        }

            .nav a:hover {
                color: white;
            }

            .nav a.active {
                color: #ff3333;
            }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            padding: 12px;
            color: #888;
            font-size: 12px;
            border-bottom: 1px solid #2a2a4a;
        }

        td {
            padding: 12px;
            font-size: 14px;
            border-bottom: 1px solid #1a1a2e;
            color: #ccc;
        }

        tr:hover {
            background: #1a1a2e;
        }

        a {
            color: #ff3333;
            text-decoration: none;
        }

        .badge {
            display: inline-block;
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .badge-ready {
            background: #1a3a1a;
            color: #28a745;
        }

        .badge-in-session {
            background: #3a1a1a;
            color: #ff3333;
        }

        .badge-offline {
            background: #2a2a2a;
            color: #888;
        }

        .badge-error {
            background: #3a2a1a;
            color: #ff6600;
        }

        .badge-booting {
            background: #1a2a3a;
            color: #3399ff;
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo">🏁 RUSH RACING</div>
        <div class="nav">
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/admin/sessions">Sessions</a>
            <a href="/admin/machines" class="active">Machines</a>
            <a href="/admin/revenue">Revenue</a>
            <a href="/admin/events">Events</a>
            <a href="/admin/logout">Logout</a>
        </div>
    </div>

    <h2 style="margin-bottom:16px;">Machines</h2>

    <table>
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Location</th>
                <th>Status</th>
                <th>CPU</th>
                <th>RAM</th>
                <th>Disk Free</th>
                <th>Last Heartbeat</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var machine in machines)
            {
                var hb = heartbeats?.GetValueOrDefault(machine.MachineId);

                var badgeClass = machine.Status switch
                {
                    RushRacing.Core.Enums.MachineStatus.Ready => "badge-ready",
                    RushRacing.Core.Enums.MachineStatus.InSession => "badge-in-session",
                    RushRacing.Core.Enums.MachineStatus.Starting => "badge-in-session",
                    RushRacing.Core.Enums.MachineStatus.GameSelect => "badge-in-session",
                    RushRacing.Core.Enums.MachineStatus.Offline => "badge-offline",
                    RushRacing.Core.Enums.MachineStatus.Error => "badge-error",
                    RushRacing.Core.Enums.MachineStatus.Booting => "badge-booting",
                    _ => "badge-offline"
                };

                <tr>
                    <td><a href="/admin/machine/@machine.MachineCode">@machine.MachineCode</a></td>
                    <td>@machine.DisplayName</td>
                    <td>@machine.Location?.Name</td>
                    <td><span class="badge @badgeClass">@machine.Status</span></td>
                    <td>@(hb?.CpuPercent?.ToString("F0") ?? "-")%</td>
                    <td>@(hb?.RamPercent?.ToString("F0") ?? "-")%</td>
                    <td>@(hb?.DiskFreeGb?.ToString("F1") ?? "-") GB</td>
                    <td>
                        @if (machine.LastHeartbeatAt.HasValue)
                        {
                            var ago = DateTimeOffset.UtcNow - machine.LastHeartbeatAt.Value;
                            <span>@((int)ago.TotalSeconds)s ago</span>
                        }
                        else
                        {
                            <span style="color:#555;">Never</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

</body>
</html>