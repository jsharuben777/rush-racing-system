@{
    Layout = null;
    var dailyRevenue = ViewBag.DailyRevenue as List<dynamic>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rush Racing — Revenue</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #0a0a1a;
            color: white;
            padding: 20px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .logo {
            font-size: 24px;
            font-weight: 900;
            color: #ff3333;
        }

        .nav a {
            color: #888;
            text-decoration: none;
            margin-left: 20px;
            font-size: 14px;
        }

            .nav a:hover {
                color: white;
            }

            .nav a.active {
                color: #ff3333;
            }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }

        th {
            text-align: left;
            padding: 12px;
            color: #888;
            font-size: 12px;
            border-bottom: 1px solid #2a2a4a;
        }

        td {
            padding: 12px;
            font-size: 16px;
            border-bottom: 1px solid #1a1a2e;
            color: #ccc;
        }

        .revenue {
            color: #28a745;
            font-weight: 700;
        }

        .card {
            background: #1a1a2e;
            border-radius: 14px;
            padding: 24px;
            margin-bottom: 20px;
        }

        .card-title {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 16px;
            color: #ccc;
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo">🏁 RUSH RACING</div>
        <div class="nav">
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/admin/sessions">Sessions</a>
            <a href="/admin/machines">Machines</a>
            <a href="/admin/revenue" class="active">Revenue</a>
            <a href="/admin/events">Events</a>
            <a href="/admin/logout">Logout</a>
        </div>
    </div>

    <h2 style="margin-bottom:16px;">Revenue — Last 7 Days</h2>

    <div class="card">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Sessions</th>
                    <th>Revenue</th>
                </tr>
            </thead>
            <tbody>
                @if (dailyRevenue != null)
                {
                    @foreach (var day in dailyRevenue)
                    {
                        <tr>
                            <td>@day.Date</td>
                            <td>@day.Sessions</td>
                            <td class="revenue">RM @(((decimal)day.Revenue).ToString("F2"))</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</body>
</html>