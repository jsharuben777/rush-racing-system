@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rush Racing — Admin Login</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #0a0a1a;
            color: white;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .login-card {
            background: #1a1a2e;
            border-radius: 20px;
            padding: 40px;
            width: 380px;
        }
        .logo {
            text-align: center;
            font-size: 28px;
            font-weight: 900;
            color: #ff3333;
            margin-bottom: 8px;
        }
        .subtitle {
            text-align: center;
            color: #888;
            font-size: 14px;
            margin-bottom: 30px;
        }
        label {
            display: block;
            color: #888;
            font-size: 13px;
            margin-bottom: 6px;
        }
        input[type="text"], input[type="password"] {
            width: 100%;
            padding: 12px 14px;
            border: 2px solid #2a2a4a;
            border-radius: 10px;
            background: #0a0a1a;
            color: white;
            font-size: 16px;
            margin-bottom: 16px;
            outline: none;
        }
        input:focus { border-color: #ff3333; }
        .btn {
            width: 100%;
            padding: 14px;
            background: #ff3333;
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
        }
        .btn:hover { background: #ff4444; }
        .error {
            background: #3a1a1a;
            border: 1px solid #ff3333;
            border-radius: 8px;
            padding: 10px;
            text-align: center;
            margin-bottom: 16px;
            font-size: 14px;
            color: #ff6666;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="logo">🏁 RUSH RACING</div>
        <div class="subtitle">Control Center</div>

        @if (ViewBag.Error != null)
        {
            <div class="error">@ViewBag.Error</div>
        }

        <form method="post" action="/admin/login">
            <label>Username</label>
            <input type="text" name="username" required autofocus />

            <label>Password</label>
            <input type="password" name="password" required />

            <button type="submit" class="btn">LOG IN</button>
        </form>
    </div>
</body>
</html>