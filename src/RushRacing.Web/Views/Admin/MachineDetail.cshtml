@{
    Layout = null;
    var machine = ViewBag.Machine as RushRacing.Core.Entities.Machine;
    var heartbeat = ViewBag.Heartbeat as RushRacing.Core.Entities.MachineHeartbeat;
    var activeSession = ViewBag.ActiveSession as RushRacing.Core.Entities.Session;
    int todaySessions = ViewBag.TodaySessions;
    decimal todayRevenue = ViewBag.TodayRevenue;
    var recentEvents = ViewBag.RecentEvents as List<RushRacing.Core.Entities.SessionEvent>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rush Racing — @machine.DisplayName</title>
    <meta http-equiv="refresh" content="10" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #0a0a1a;
            color: white;
            padding: 20px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .logo {
            font-size: 24px;
            font-weight: 900;
            color: #ff3333;
        }

        .nav a {
            color: #888;
            text-decoration: none;
            margin-left: 20px;
            font-size: 14px;
        }

            .nav a:hover {
                color: white;
            }

        .card {
            background: #1a1a2e;
            border-radius: 14px;
            padding: 24px;
            margin-bottom: 20px;
        }

        .card-title {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 16px;
            color: #ccc;
        }

        .row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #2a2a4a;
        }

        .row-label {
            color: #888;
            font-size: 14px;
        }

        .row-value {
            font-size: 14px;
        }

        .stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 20px;
        }

        .stat-card {
            background: #1a1a2e;
            border-radius: 14px;
            padding: 20px;
        }

        .stat-label {
            color: #888;
            font-size: 13px;
            margin-bottom: 6px;
        }

        .stat-value {
            font-size: 24px;
            font-weight: 800;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            padding: 8px;
            color: #888;
            font-size: 12px;
            border-bottom: 1px solid #2a2a4a;
        }

        td {
            padding: 8px;
            font-size: 13px;
            border-bottom: 1px solid #1a1a2e;
            color: #ccc;
        }

        .badge {
            display: inline-block;
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .badge-ready {
            background: #1a3a1a;
            color: #28a745;
        }

        .badge-session {
            background: #3a1a1a;
            color: #ff3333;
        }

        .badge-offline {
            background: #2a2a2a;
            color: #888;
        }

        .badge-error {
            background: #3a2a1a;
            color: #ff6600;
        }

        .back-link {
            color: #ff3333;
            text-decoration: none;
            font-size: 14px;
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo">🏁 RUSH RACING</div>
        <div class="nav">
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/admin/sessions">Sessions</a>
            <a href="/admin/machines">Machines</a>
            <a href="/admin/logout">Logout</a>
        </div>
    </div>

    <a href="/admin/machines" class="back-link">← Back to Machines</a>

    <h2 style="margin:16px 0;">@machine.DisplayName (@machine.MachineCode)</h2>

    <!-- Stats -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-label">Status</div>
            @{
                var badgeClass = machine.Status switch
                {
                    RushRacing.Core.Enums.MachineStatus.Ready => "badge-ready",
                    RushRacing.Core.Enums.MachineStatus.InSession => "badge-session",
                    RushRacing.Core.Enums.MachineStatus.Offline => "badge-offline",
                    RushRacing.Core.Enums.MachineStatus.Error => "badge-error",
                    _ => "badge-offline"
                };
            }
            <span class="badge @badgeClass" style="font-size:16px; padding:6px 16px;">@machine.Status</span>
        </div>
        <div class="stat-card">
            <div class="stat-label">Today's Sessions</div>
            <div class="stat-value">@todaySessions</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Today's Revenue</div>
            <div class="stat-value" style="color:#28a745;">RM @todayRevenue.ToString("F2")</div>
        </div>
    </div>

    <!-- Active Session -->
    @if (activeSession != null)
    {
        <div class="card" style="border-left: 4px solid #ff3333;">
            <div class="card-title">🏎️ Active Session</div>
            <div class="row"><span class="row-label">Session</span><span class="row-value">@activeSession.SessionCode</span></div>
            <div class="row"><span class="row-label">Game</span><span class="row-value">@(activeSession.SelectedGame?.DisplayName ?? "-")</span></div>
            @if (activeSession.SessionExpiresAt.HasValue)
            {
                var remaining = activeSession.SessionExpiresAt.Value - DateTimeOffset.UtcNow;
                <div class="row">
                    <span class="row-label">Time Remaining</span>
                    <span class="row-value" style="color:#ff3333; font-weight:700;">
                        @(remaining > TimeSpan.Zero ? remaining.ToString(@"mm\:ss") : "Expired")
                    </span>
                </div>
            }
        </div>
    }

    <!-- Hardware Info -->
    <div class="card">
        <div class="card-title">Hardware Status</div>
        @if (heartbeat != null)
        {
            <div class="row"><span class="row-label">CPU Usage</span><span class="row-value">@(heartbeat.CpuPercent?.ToString("F0") ?? "-")%</span></div>
            <div class="row"><span class="row-label">RAM Usage</span><span class="row-value">@(heartbeat.RamPercent?.ToString("F0") ?? "-")%</span></div>
            <div class="row"><span class="row-label">GPU Temperature</span><span class="row-value">@(heartbeat.GpuTempCelsius?.ToString("F0") ?? "-")°C</span></div>
            <div class="row"><span class="row-label">Disk Free</span><span class="row-value">@(heartbeat.DiskFreeGb?.ToString("F1") ?? "-") GB</span></div>
            <div class="row"><span class="row-label">Internet</span><span class="row-value">@(heartbeat.InternetStatus ?? "-")</span></div>
            <div class="row"><span class="row-label">Agent Version</span><span class="row-value">@(heartbeat.AgentVersion ?? "-")</span></div>
            <div class="row"><span class="row-label">Last Heartbeat</span><span class="row-value">@heartbeat.ReceivedAt.ToLocalTime().ToString("HH:mm:ss")</span></div>
        }
        else
        {
            <div style="color:#888;">No heartbeat data received.</div>
        }
    </div>

    <!-- Recent Events -->
    <div class="card">
        <div class="card-title">Recent Events</div>
        <table>
            <thead><tr><th>Time</th><th>Event</th><th>Details</th><th>Source</th></tr></thead>
            <tbody>
                @foreach (var evt in recentEvents)
                {
                    <tr>
                        <td>@evt.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                        <td>@evt.EventType</td>
                        <td>@evt.Details</td>
                        <td>@evt.Source</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</body>
</html>