@model RushRacing.Core.Entities.Session
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rush Racing — Session @Model.SessionCode</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #0a0a1a;
            color: white;
            padding: 20px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .logo {
            font-size: 24px;
            font-weight: 900;
            color: #ff3333;
        }

        .nav a {
            color: #888;
            text-decoration: none;
            margin-left: 20px;
            font-size: 14px;
        }

            .nav a:hover {
                color: white;
            }

        .card {
            background: #1a1a2e;
            border-radius: 14px;
            padding: 24px;
            margin-bottom: 20px;
        }

        .card-title {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 16px;
            color: #ccc;
        }

        .row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #2a2a4a;
        }

        .row-label {
            color: #888;
            font-size: 14px;
        }

        .row-value {
            font-size: 14px;
        }

        .badge {
            display: inline-block;
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .badge-completed {
            background: #1a3a1a;
            color: #28a745;
        }

        .badge-active {
            background: #3a1a1a;
            color: #ff3333;
        }

        .badge-error {
            background: #3a2a1a;
            color: #ff6600;
        }

        .badge-other {
            background: #2a2a4a;
            color: #888;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            padding: 8px;
            color: #888;
            font-size: 12px;
            border-bottom: 1px solid #2a2a4a;
        }

        td {
            padding: 8px;
            font-size: 13px;
            border-bottom: 1px solid #1a1a2e;
            color: #ccc;
        }

        .back-link {
            color: #ff3333;
            text-decoration: none;
            font-size: 14px;
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo">🏁 RUSH RACING</div>
        <div class="nav">
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/admin/sessions">Sessions</a>
            <a href="/admin/machines">Machines</a>
            <a href="/admin/logout">Logout</a>
        </div>
    </div>

    <a href="/admin/sessions" class="back-link">← Back to Sessions</a>

    <h2 style="margin:16px 0;">Session @Model.SessionCode</h2>

    <div class="card">
        <div class="card-title">Session Details</div>
        <div class="row"><span class="row-label">Session Code</span><span class="row-value">@Model.SessionCode</span></div>
        <div class="row"><span class="row-label">Machine</span><span class="row-value">@Model.Machine?.DisplayName (@Model.Machine?.MachineCode)</span></div>
        <div class="row"><span class="row-label">Game</span><span class="row-value">@(Model.SelectedGame?.DisplayName ?? "Not selected")</span></div>
        <div class="row"><span class="row-label">Duration</span><span class="row-value">@Model.DurationMinutes minutes</span></div>
        <div class="row"><span class="row-label">Price</span><span class="row-value">RM @Model.PriceAmount.ToString("F2")</span></div>
        <div class="row">
            <span class="row-label">Status</span>
            @{
                var badgeClass = Model.Status switch
                {
                    RushRacing.Core.Enums.SessionStatus.Completed => "badge-completed",
                    RushRacing.Core.Enums.SessionStatus.Active => "badge-active",
                    RushRacing.Core.Enums.SessionStatus.MachineError => "badge-error",
                    _ => "badge-other"
                };
            }
            <span class="badge @badgeClass">@Model.Status</span>
        </div>
        <div class="row"><span class="row-label">Created</span><span class="row-value">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span></div>
        <div class="row"><span class="row-label">Paid At</span><span class="row-value">@(Model.PaidAt?.ToLocalTime().ToString("HH:mm:ss") ?? "-")</span></div>
        <div class="row"><span class="row-label">Started At</span><span class="row-value">@(Model.SessionStartedAt?.ToLocalTime().ToString("HH:mm:ss") ?? "-")</span></div>
        <div class="row"><span class="row-label">Expires At</span><span class="row-value">@(Model.SessionExpiresAt?.ToLocalTime().ToString("HH:mm:ss") ?? "-")</span></div>
        <div class="row"><span class="row-label">Ended At</span><span class="row-value">@(Model.SessionEndedAt?.ToLocalTime().ToString("HH:mm:ss") ?? "-")</span></div>
    </div>

    @if (Model.Payments?.Any() == true)
    {
        <div class="card">
            <div class="card-title">Payments</div>
            <table>
                <thead>
                    <tr><th>ID</th><th>Provider</th><th>Amount</th><th>Status</th><th>Paid At</th></tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model.Payments)
                    {
                        <tr>
                            <td>@payment.ExternalPaymentId</td>
                            <td>@payment.PaymentProvider</td>
                            <td>RM @payment.Amount.ToString("F2")</td>
                            <td>@payment.Status</td>
                            <td>@(payment.PaidAt?.ToLocalTime().ToString("HH:mm:ss") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.Events?.Any() == true)
    {
        <div class="card">
            <div class="card-title">Event Log</div>
            <table>
                <thead>
                    <tr><th>Time</th><th>Event</th><th>Details</th><th>Source</th></tr>
                </thead>
                <tbody>
                    @foreach (var evt in Model.Events)
                    {
                        <tr>
                            <td>@evt.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                            <td>@evt.EventType</td>
                            <td>@evt.Details</td>
                            <td>@evt.Source</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</body>
</html>