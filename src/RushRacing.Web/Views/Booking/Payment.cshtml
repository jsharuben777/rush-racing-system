@model RushRacing.Core.Entities.Session
@{
    Layout = null;
    var error = ViewBag.Error as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Rush Racing — Payment</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #0a0a1a;
            color: white;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .card {
            background: #1a1a2e;
            border-radius: 20px;
            padding: 40px 30px;
            max-width: 400px;
            width: 100%;
            text-align: center;
        }

        .logo {
            font-size: 24px;
            font-weight: 900;
            color: #ff3333;
        }

        .session-code {
            font-size: 12px;
            color: #666;
            margin: 8px 0 24px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #2a2a4a;
            font-size: 16px;
        }

        .summary-label {
            color: #888;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 16px 0;
            font-size: 22px;
            font-weight: 700;
        }

        .total-amount {
            color: #ff3333;
        }

        .error-banner {
            margin-top: 16px;
            padding: 10px 14px;
            background: #3a1414;
            border: 1px solid #ff3333;
            border-radius: 10px;
            color: #ff9999;
            font-size: 13px;
            text-align: left;
        }

        .email-label {
            display: block;
            text-align: left;
            font-size: 13px;
            color: #888;
            margin-top: 20px;
            margin-bottom: 6px;
        }

        .email-input {
            width: 100%;
            padding: 12px 14px;
            background: #0f0f22;
            border: 2px solid #2a2a4a;
            border-radius: 10px;
            color: white;
            font-size: 15px;
        }

        .email-input:focus {
            outline: none;
            border-color: #ff3333;
        }

        .pay-btn {
            width: 100%;
            padding: 16px;
            margin-top: 20px;
            background: #ff3333;
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 18px;
            font-weight: 700;
            cursor: pointer;
        }

            .pay-btn:hover {
                background: #ff4444;
            }

        .note {
            margin-top: 16px;
            font-size: 12px;
            color: #555;
        }
    </style>
</head>
<body>

    <div class="card">
        <div class="logo">🏁 RUSH RACING</div>
        <div class="session-code">Session: @Model.SessionCode</div>

        <div class="summary-row">
            <span class="summary-label">Cockpit</span>
            <span>@Model.Machine.DisplayName</span>
        </div>
        <div class="summary-row">
            <span class="summary-label">Duration</span>
            <span>@Model.DurationMinutes minutes</span>
        </div>
        <div class="total-row">
            <span>Total</span>
            <span class="total-amount">RM @Model.PriceAmount.ToString("F2")</span>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="error-banner">@error</div>
        }

        <form method="post" action="/race/payment/@Model.SessionCode/create-bill">
            <label for="email" class="email-label">Email (for your receipt)</label>
            <input type="email" id="email" name="email" required
                   placeholder="you@example.com" class="email-input"
                   value="@Model.CustomerEmail" />

            <button type="submit" class="pay-btn">
                PAY RM @Model.PriceAmount.ToString("F2")
            </button>
        </form>

        <div class="note">
            You will be redirected to a secure payment page.
        </div>
    </div>

</body>
</html>
