<UserControl x:Class="RushRacing.Kiosk.Views.GameSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#0A0A1A">

        <!-- Main Content -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="🏁 RUSH RACING"
                       Foreground="#FF3333"
                       FontSize="36"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="CHOOSE YOUR RACE"
                       Foreground="White"
                       FontSize="32"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Game Cards -->
            <StackPanel x:Name="GameCardsPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"/>

            <TextBlock x:Name="SessionInfoText"
                       Text="Your session: 20 minutes"
                       Foreground="#888888"
                       FontSize="20"
                       HorizontalAlignment="Center"
                       Margin="0,40,0,10"/>

            <TextBlock Text="⚠ Your game choice is locked for this session."
                       Foreground="#AAAA00"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>

            <TextBlock Text="To try a different game, start a new session."
                       Foreground="#888888"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="← USE D-PAD TO SELECT  •  PRESS A TO START →"
                       Foreground="#555555"
                       FontSize="16"
                       HorizontalAlignment="Center"/>

        </StackPanel>

        <!-- Confirmation Overlay -->
        <Border x:Name="ConfirmationOverlay"
                Visibility="Collapsed"
                Background="#DD000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#2A2A4A"
                    CornerRadius="20"
                    Width="500" Height="350"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="40">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="You selected:"
                               Foreground="#AAAAAA"
                               FontSize="22"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ConfirmGameName"
                               Text=""
                               Foreground="White"
                               FontSize="38"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,24"/>
                    <TextBlock Text="Your timer will start once the game is ready."
                               Foreground="#AAAAAA"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,30"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#28A745" CornerRadius="10"
                                Padding="24,12" Margin="10,0">
                            <TextBlock Text="A — CONFIRM"
                                       Foreground="White" FontSize="20" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#555555" CornerRadius="10"
                                Padding="24,12" Margin="10,0">
                            <TextBlock Text="B — GO BACK"
                                       Foreground="White" FontSize="20" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Timeout Warning Overlay -->
        <Border x:Name="TimeoutWarningOverlay"
                Visibility="Collapsed"
                Background="#DD000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏱ Are you still there?"
                           Foreground="White" FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Press any button to continue"
                           Foreground="#AAAAAA" FontSize="20"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock x:Name="TimeoutCountdownText"
                           Text="Session will end in 30s..."
                           Foreground="#FF3333" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>